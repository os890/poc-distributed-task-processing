@startuml
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 13
skinparam roundCorner 8
skinparam ArrowColor #444444
skinparam BorderColor #555555
hide empty description
skinparam StateBackgroundColor #eef3fb
skinparam StateBorderColor #4a6fa5
skinparam NoteBackgroundColor #fffbe6
skinparam NoteBorderColor #b28704
left to right direction
[*] --> FREE : job created
FREE --> HELD : acquire, token + 1
HELD --> HELD : renew with matching token
HELD --> FREE : release on finish with matching token
HELD --> EXPIRED : lease_until passed, derived state
EXPIRED --> FREE : reaper takeover, token + 1
EXPIRED --> HELD : late renew before the reaper ran, same token
@enduml
