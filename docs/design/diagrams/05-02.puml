@startuml
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 13
skinparam roundCorner 8
skinparam ArrowColor #444444
skinparam BorderColor #555555
skinparam sequenceMessageAlign left
skinparam ParticipantPadding 10
skinparam BoxPadding 10
skinparam NoteBackgroundColor #fffbe6
skinparam NoteBorderColor #b28704
skinparam ParticipantBackgroundColor #eef3fb
skinparam ParticipantBorderColor #4a6fa5
skinparam SequenceGroupBodyBackgroundColor transparent
autonumber
participant "Node A - RunClaimer" as A
participant "Node B - RunClaimer" as B
participant "Database" as DB

note over A, B : poll times are jittered, a collision is rare but must be safe
par Node A polls
A -> DB : BEGIN, SELECT free job leases with a pending run FOR UPDATE OF lease SKIP LOCKED
DB --> A : lease row of job J1 locked by A, candidate run R1
else Node B polls at the same moment
B -> DB : BEGIN, SELECT free job leases with a pending run FOR UPDATE OF lease SKIP LOCKED
DB --> B : J1 is locked and skipped, returns J2 with run R2 or nothing
end
A -> DB : UPDATE dtp_job_lease J1 SET run R1, owner A, token + 1 WHERE run IS NULL
DB --> A : 1 row, fencing token 42
A -> DB : UPDATE dtp_run R1 to RUNNING WHERE state PENDING, INSERT dtp_run_attempt
A -> DB : COMMIT
alt B got J2
B -> DB : acquire lease J2, start R2, COMMIT
else B got nothing
B -> DB : ROLLBACK, empty transaction
B -> B : idle backoff, next poll = interval x 2, capped, plus jitter
end
@enduml
