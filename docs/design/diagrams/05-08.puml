@startuml
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 13
skinparam roundCorner 8
skinparam ArrowColor #444444
skinparam BorderColor #555555
skinparam sequenceMessageAlign left
skinparam ParticipantPadding 10
skinparam BoxPadding 10
skinparam NoteBackgroundColor #fffbe6
skinparam NoteBorderColor #b28704
skinparam ParticipantBackgroundColor #eef3fb
skinparam ParticipantBorderColor #4a6fa5
skinparam SequenceGroupBodyBackgroundColor transparent
autonumber
participant "RunPlanner (leader)" as PL
participant "RunExecutor" as EX
participant "JobHandler" as H
participant "Database" as DB

note over PL, DB : slot business days 18:00 to 22:00, item limit 500000
EX -> H : execute(ctx)
H -> EX : ctx.packages().createFrom(changes, 1000)
EX -> DB : insert 800 work packages PENDING
loop forEachPending
EX -> DB : limit or slot end reached?
alt no
EX --> H : next package
H -> EX : pkg.done()
EX -> DB : fenced commit, package DONE
else 500 packages done, item limit reached
EX -> EX : stop reason LIMIT_REACHED
end
end
note over EX, DB : at 22:00 the LeaseKeeper raises SLOT_END in the same way.\nA package in progress is always finished first.
EX -> DB : finish run, outcome DEFERRED, 300 packages stay PENDING
PL -> DB : next business day 18:00, INSERT run with run_key cron job + slot
note over PL, DB : the new run processes the 300 carried-over packages first
@enduml
