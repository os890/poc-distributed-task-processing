@startuml
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 13
skinparam roundCorner 8
skinparam ArrowColor #444444
skinparam BorderColor #555555
skinparam sequenceMessageAlign left
skinparam ParticipantPadding 10
skinparam BoxPadding 10
skinparam NoteBackgroundColor #fffbe6
skinparam NoteBorderColor #b28704
skinparam ParticipantBackgroundColor #eef3fb
skinparam ParticipantBorderColor #4a6fa5
skinparam SequenceGroupBodyBackgroundColor transparent
autonumber
participant "RunExecutor (Node A)" as EX
participant "JobHandler (CDI bean)" as H
participant "LeaseKeeper (Node A)" as LK
participant "Database" as DB

EX -> H : execute(ctx) on a virtual thread
loop every renew-interval, in parallel
LK -> DB : UPDATE lease_until WHERE job AND run AND token 42
DB --> LK : 1 row, still owner
LK -> DB : read stop flags of own runs
end
loop ctx.inbox().forEachBatch(500)
H -> EX : next batch
EX -> DB : BEGIN, keyset read of 500 QUEUED items, mark IN_PROGRESS
EX --> H : batch of TrackedItem
H -> DB : business changes via JPA, same JTA transaction
H -> EX : item.routeTo, item.routeBack, item.escalate, item.complete
EX -> DB : JDBC batch: update dtp_item, upsert dtp_item_visit, insert dtp_item_event
EX -> DB : fence check as the last statement: UPDATE lease WHERE token 42
DB --> EX : 1 row, still owner
EX -> DB : COMMIT
EX -> EX : check stop signal between batches
end
H --> EX : JobResult.success()
EX -> DB : BEGIN fenced finish, see 5.5
@enduml
