@startuml
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 13
skinparam roundCorner 8
skinparam ArrowColor #444444
skinparam BorderColor #555555
left to right direction
skinparam RectangleBackgroundColor #eef3fb
skinparam RectangleBorderColor #4a6fa5
skinparam UsecaseBackgroundColor #eef3fb
skinparam UsecaseBorderColor #4a6fa5
skinparam DatabaseBackgroundColor #f3eefb
skinparam DatabaseBorderColor #6a4aa5
skinparam HexagonBackgroundColor #fff3c4
skinparam HexagonBorderColor #b28704
skinparam ActorBorderColor #4a6fa5
rectangle "OrderValidation" as VAL
rectangle "CreditCheck\nPASSED" as CC
rectangle "PlausibilityCheck\nPASSED on attempt 3" as PC #ffe2b8;line:e65100;text:1b1b1b
rectangle "AddressCheck\nPASSED" as AC
rectangle "ScreeningEvaluation" as SE
rectangle "AvailabilityCheck" as AV

VAL --> CC : 2 fork
VAL --> PC : 2 fork
VAL --> AC : 2 fork
PC ..> PC : 4, 6 retry 2×\ntechnical: SocketTimeoutException
CC --> SE : 3
AC --> SE : 5
PC --> SE : 8 join
SE --> AV : 9
@enduml
